# Copy this file as application-local.properties
# Do not commit it — it holds credentials (already in .gitignore)

# ---------- Option 1: local Postgres with Docker ----------
# Start it with: docker compose up -d postgres
spring.datasource.url=jdbc:postgresql://localhost:5432/medico_db
spring.datasource.username=medico_user
spring.datasource.password=CHANGE_ME

# ---------- Option 2: remote Postgres on Render ----------
# Uncomment and use the EXTERNAL URL with sslmode=require
#spring.datasource.url=jdbc:postgresql://HOST:5432/DB_NAME?sslmode=require
#spring.datasource.username=CHANGE_ME
#spring.datasource.password=CHANGE_ME

# ---------- JWT and CORS ----------
jwt.secret=CHANGE_ME_USE_AT_LEAST_32_CHARACTERS
app.cors.allowed-origins=http://localhost:4200

# ---------- Optional email notices ----------
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=user
# MAIL_PASSWORD=app-password
# MAIL_FROM=notificaciones@example.com
